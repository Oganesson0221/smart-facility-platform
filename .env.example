# Application
APP_NAME=Smart Facility Platform
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./data/exitwatch.db
MAX_UPLOAD_MB=250

# Computer vision: demo | grounding_dino
DETECTOR_PROVIDER=demo
DEVICE=auto
GROUNDING_DINO_MODEL=IDEA-Research/grounding-dino-tiny
DETECTION_PROMPT=vehicle . car . truck . motorcycle . trolley . pallet . cardboard box . large object . person .
DETECTION_THRESHOLD=0.35
BLOCKED_CLASSES=vehicle,car,truck,motorcycle,trolley,pallet,box,cardboard box,large object
MINIMUM_OVERLAP=0.25
MINIMUM_DURATION_SECONDS=5
CLEAR_AFTER_SECONDS=3
VIDEO_SAMPLE_FPS=3
ALERT_COOLDOWN_SECONDS=300

# Local OpenAI-compatible model (Ollama, vLLM, or NVIDIA NIM)
LLM_ENABLED=true
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=qwen3:32b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=45

# NVIDIA NeMo Agent Toolkit (separate local Python 3.11+ runtime)
NEMO_AGENT_ENABLED=true
NEMO_AGENT_BASE_URL=http://127.0.0.1:8010/v1
NEMO_AGENT_MODEL=smart-facility-agent
NEMO_AGENT_API_KEY=
NEMO_AGENT_TIMEOUT_SECONDS=120
NEMO_AGENT_REQUIRED=true

# Local multimodal scene reasoning (Ollama)
VISION_ENABLED=true
VISION_BASE_URL=http://127.0.0.1:11434
VISION_MODEL=gemma3:27b
VISION_TIMEOUT_SECONDS=180

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
USER_ID=
TELEGRAM_WEBHOOK_SECRET=change-me-before-enabling-webhooks
TELEGRAM_BOT_USERNAME=SmartFacilityAssistant_bot
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_POLL_TIMEOUT_SECONDS=25
