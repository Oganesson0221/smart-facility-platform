# Application
APP_NAME=Smart Facility Platform
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
DATABASE_URL=sqlite:///./data/exitwatch.db
MAX_UPLOAD_MB=250

# Computer vision: demo | grounding_dino | yolo
DETECTOR_PROVIDER=yolo
DEVICE=auto
# With both vLLM servers enabled, keep auto-selected YOLO/SAM devices on CPU to
# avoid CUDA allocation failures. Explicit YOLO_DEVICE/SAM_DEVICE values win.
CV_SHARED_GPU_SAFE_MODE=true
YOLO_MODEL_PATH=yolo11n.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_IMAGE_SIZE=640
YOLO_DEVICE=auto
SAM_ENABLED=true
SAM_PROVIDER=sam2
SAM_MODEL_SIZE=tiny
SAM_CHECKPOINT_PATH=third_party/sam2/checkpoints/sam2.1_hiera_tiny.pt
SAM_DEVICE=auto
SAM_USE_FP16=true
SAM_MIN_YOLO_CONFIDENCE=0.35
SAM_ONLY_FOR_ZONE_CANDIDATES=true
SAM_BOUNDARY_MARGIN_PIXELS=20
SAM_MASK_SIMPLIFICATION_EPSILON=2.0
SAM_PROMPT_BOX_EXPAND_RATIO=0.03
SAM_FAIL_OPEN=true
GROUNDING_DINO_MODEL=IDEA-Research/grounding-dino-tiny
DETECTION_PROMPT=vehicle . car . truck . motorcycle . trolley . pallet . cardboard box . large object . person .
DETECTION_THRESHOLD=0.35
BLOCKED_CLASSES=
FIRE_EXIT_OBSTRUCTION_CLASSES=car,truck,bus,motorcycle,bicycle,chair
INCLUDE_PERSON_AS_OBSTRUCTION=false
PERSON_MINIMUM_DURATION_SECONDS=15
MINIMUM_OBJECT_INTRUSION_RATIO=0.25
MINIMUM_OVERLAP=0.25
MINIMUM_EXIT_BLOCKAGE_RATIO=0.05
MINIMUM_DURATION_SECONDS=5
CLEAR_AFTER_SECONDS=3
VIDEO_SAMPLE_FPS=3
ALERT_COOLDOWN_SECONDS=300

# Local OpenAI-compatible text orchestrator (vLLM recommended)
# Optional Hugging Face download token. Do not reuse it as a local API key.
HF_TOKEN=
LLM_ENABLED=true
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# Optional local path if the weights live outside this repo.
LLM_MODEL_SOURCE=
LLM_MAX_MODEL_LEN=8192
LLM_GPU_MEMORY_UTILIZATION=0.35
LLM_API_KEY=
# Optional vLLM parser overrides. Qwen 2.5 defaults to the Hermes tool parser.
LLM_TOOL_CALL_PARSER=
LLM_REASONING_PARSER=
LLM_TIMEOUT_SECONDS=45

# NVIDIA NeMo Switchyard Stage Router (official standalone Rust server)
SWITCHYARD_ENABLED=true
SWITCHYARD_BASE_URL=http://127.0.0.1:4000
SWITCHYARD_MODEL=switchyard/exitwatch-stage
SWITCHYARD_API_KEY=
SWITCHYARD_TIMEOUT_SECONDS=60
# Text-only calls may use Qwen directly if the routing proxy is unavailable.
SWITCHYARD_FALLBACK_ENABLED=true
SWITCHYARD_ROUTING_LOG_PATH=logs/switchyard-routing.jsonl
SWITCHYARD_UI_ENABLED=true
SWITCHYARD_CONFIG=config/switchyard/routes.toml

# NVIDIA NeMo Agent Toolkit (separate local Python 3.11+ runtime)
NEMO_AGENT_ENABLED=true
NEMO_AGENT_BASE_URL=http://127.0.0.1:8010/v1
NEMO_AGENT_MODEL=smart-facility-agent
NEMO_AGENT_API_KEY=
NEMO_AGENT_TIMEOUT_SECONDS=120
NEMO_AGENT_REQUIRED=true
NEMO_AGENT_ORCHESTRATE_CV=true
NEMO_AGENT_ORCHESTRATE_VISION=true

# Local OpenAI-compatible multimodal model (vLLM or another local checkpoint server)
VISION_ENABLED=true
VISION_BASE_URL=http://127.0.0.1:8002/v1
VISION_MODEL=nvidia/Nemotron-3-Nano-Omni-30B-A3B-Reasoning-NVFP4
# Optional local path if the weights live outside this repo.
VISION_MODEL_SOURCE=
VISION_MAX_MODEL_LEN=8192
VISION_GPU_MEMORY_UTILIZATION=0.25
VISION_API_KEY=
VISION_KEEP_ALIVE=30m
# Structured validation uses instruct mode so short JSON responses are not
# consumed by the model's reasoning trace.
VISION_ENABLE_THINKING=false
VISION_REASONING_PARSER=nemotron_v3
VISION_TOOL_CALL_PARSER=qwen3_coder
VISION_KV_CACHE_DTYPE=fp8
VISION_MOE_BACKEND=marlin
VISION_MAX_NUM_SEQS=8
VISION_MAX_NUM_BATCHED_TOKENS=32768
VISION_TIMEOUT_SECONDS=180
VISION_VALIDATION_TIMEOUT_SECONDS=60
VISION_VALIDATION_IMAGE_MAX_DIM=768
VISION_VALIDATION_JPEG_QUALITY=80
VISION_VALIDATION_MAX_RESPONSE_TOKENS=300
VALIDATE_FIRE_EXIT_INCIDENTS_WITH_VISION=true
VISION_VALIDATION_FAIL_CLOSED=false

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
USER_ID=
TELEGRAM_WEBHOOK_SECRET=change-me-before-enabling-webhooks
TELEGRAM_BOT_USERNAME=SmartFacilityAssistant_bot
TELEGRAM_POLLING_ENABLED=true
TELEGRAM_POLL_TIMEOUT_SECONDS=25
